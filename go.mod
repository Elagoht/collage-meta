// A collage plugin that writes the tags a page is shared and indexed by — Open
// Graph, Twitter cards, the canonical URL, the description and the page's
// translations — into the head, from site-wide defaults and what each page says.
//
// It requires collage the way any consumer does, and reaches nothing the framework
// does not offer every plugin.
module github.com/Elagoht/collage-meta

go 1.26

require github.com/Elagoht/collage v0.50.0
